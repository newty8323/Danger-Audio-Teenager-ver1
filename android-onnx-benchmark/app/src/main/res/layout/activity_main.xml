<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danger Audio — 미디어 분석" android:textStyle="bold" android:textSize="22sp" />
    <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="선택한 음원·영상 파일의 오디오를 직접 4초마다 CED-mini → Demucs → 원본 Whisper Base → KoELECTRA로 처리합니다. 위험 시에만 설정한 Qwen 서버로 원음과 텍스트를 전송합니다." />
    <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="선택: Qwen 서버 주소 (예: http://192.168.x.x:8770/)" android:inputType="textUri" />
    <Button android:id="@+id/chooseButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="미디어 파일 선택" />
    <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="선택한 미디어 분석 시작" android:enabled="false" />
    <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="중지" android:enabled="false" />
    <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textIsSelectable="true" android:text="미디어 파일을 선택하면 4초 단위 분석을 시작할 수 있습니다." android:fontFamily="monospace" />
  </LinearLayout>
</ScrollView>
